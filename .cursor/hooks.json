{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-shell.sh",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/guard-read.sh",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/post-edit.sh",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/secret-scan.sh",
        "timeout": 30,
        "loop_limit": 2
      },
      {
        "command": ".cursor/hooks/verify.sh",
        "timeout": 180,
        "loop_limit": 2
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/verify.sh",
        "matcher": "Write|Edit|StrReplace|MultiEdit",
        "timeout": 60
      }
    ]
  }
}
