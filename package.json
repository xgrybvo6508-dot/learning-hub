    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
